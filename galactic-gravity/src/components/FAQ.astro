---
/**
 * FAQ.astro: Seção de Perguntas Frequentes (FAQ) em HTML semântico com accordion nativo
 * Renderizado no servidor para indexação perfeita no Google e IA engines.
 */
import { faqs } from '../data/faqs';
---

<section class="py-12 sm:py-16" id="faq" aria-labelledby="faq-heading">
  <div class="section-container">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-8">
        <p class="mono-eyebrow mb-2">PERGUNTAS FREQUENTES</p>
        <h2 id="faq-heading" class="text-xl sm:text-2xl font-semibold" style="color: var(--color-g-ink);">
          FAQ — Perguntas Frequentes sobre Horas Extras e CLT
        </h2>
        <p class="mt-2 text-sm sm:text-base leading-relaxed" style="color: var(--color-g-body);">
          Respostas objetivas e fundamentadas na legislação trabalhista brasileira para sanar todas as suas dúvidas sobre horas extras, adicionais de 50% e 100%, DSR e banco de horas.
        </p>
      </div>

      <div class="faq-list" id="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item" name="faq">
            <summary class="faq-question">
              <span class="faq-q-text">{faq.question}</span>
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    border: 1px solid var(--color-g-hairline);
    border-radius: var(--radius-md);
    background: var(--color-g-elevated);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .faq-item:hover {
    border-color: var(--color-g-mute);
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--color-g-link) 40%, var(--color-g-hairline));
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    -webkit-user-select: none;
    transition: background 0.15s;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    content: '';
  }

  .faq-question:hover {
    background: color-mix(in srgb, var(--color-g-link) 4%, transparent);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-g-link);
    outline-offset: -2px;
  }

  .faq-q-text {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-g-ink);
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .faq-q-text {
      font-size: 15px;
    }
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--color-g-mute);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-g-link);
  }

  .faq-answer {
    padding: 0 20px 16px;
    animation: faq-fade-in 0.2s ease;
  }

  .faq-answer p {
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-g-body);
  }

  @media (min-width: 640px) {
    .faq-answer p {
      font-size: 14px;
    }
    .faq-question {
      padding: 18px 24px;
    }
    .faq-answer {
      padding: 0 24px 20px;
    }
  }

  @keyframes faq-fade-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
