---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Calculator from '../components/Calculator.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import SeoContent from '../components/SeoContent.astro';
import { legalStatus } from '../data/legal-status';

// Title: 59 chars (<= 60 chars)
const pageTitle = "Calculadora de Horas Extras 2026 (CLT + DSR) - Grátis Online";
// Meta Description: 157 chars (140-158 chars)
const pageDescription = "Calcule horas extras a 50% e 100% com DSR pela CLT. Ferramenta grátis, sem cadastro e 100% privada no navegador com suporte a minutos. Simule seu pagamento!";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://calculadoradehorasextrasonline.com/"
>
  <Navbar />
  <main class="flex-1">
    <!-- Hero heading com Answer-first intro sob H1 -->
    <div class="section-container pt-6 sm:pt-8 text-center">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight" style="color: var(--color-g-ink);">
        Calculadora de Horas Extras
      </h1>
      <p class="mt-3 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed" style="color: var(--color-g-body);">
        Esta <strong>calculadora de horas extras</strong> apura instantaneamente o adicional de 50% e 100% e o reflexo do DSR conforme a CLT para {legalStatus.year}. Insira seu salário mensal bruto ou valor da hora, lance jornadas reais com minutos e visualize seus ganhos por semana, mês ou ano com total privacidade no seu navegador.
      </p>
    </div>

    <!-- Calculator Component -->
    <Calculator hideTitle={true} />

    <div class="section-container">
      <hr class="my-8 sm:my-12" style="border-color: var(--color-g-hairline);" />
    </div>

    <!-- SEO Content -->
    <SeoContent />

    <div class="section-container">
      <hr class="my-8 sm:my-12" style="border-color: var(--color-g-hairline);" />
    </div>

    <!-- FAQ Section -->
    <FAQ />
  </main>
  <Footer />
</Layout>
